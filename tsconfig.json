{
  "compilerOptions": {
    // Property tests use effect/Arbitrary, which Effect marks unstable; we use it on purpose. tsconfig.src.json drops this allowance so src and bin stay clean.
    "plugins": [{ "name": "@effect/language-service", "allowedUnstableApis": ["effect/Arbitrary"] }],
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "bin", "test"]
}
