{
  "name": "@joelhooks/peons",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Warm agent templates, forked per request: the peon catalog.",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  },
  "pi": {
    "extensions": [
      "./extensions/pi"
    ]
  },
  "scripts": {
    "test": "vitest run",
    "check:pi": "node extensions/pi/check-types.ts",
    "digest": "node bin/digest.ts",
    "lint": "oxlint src bin extensions test",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict && effect-tsrs diagnostics --project tsconfig.src.json --strict",
    "typecheck:tsc": "tsc --noEmit",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/opentype.js": "^1.3.10",
    "@yielded/effect-tsrs": "0.2.0",
    "opentype.js": "1.3.4",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "typescript": "5.9.3",
    "ultracite": "8.0.1",
    "vitest": "5.0.3"
  }
}
